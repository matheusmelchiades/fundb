-- ══════════════════════════════════════════════════════════════════════════════
-- ARTICLES — 8 articles for semantic search testing
-- ══════════════════════════════════════════════════════════════════════════════

INSERT INTO articles (title, body, author, category, published_at, _vector)
VALUES (
  'Introduction to FunDB',
  'FunDB is an AI-native cognitive database designed for the next generation of applications. It combines document storage, vector search, graph traversal, and causal reasoning into a single unified system.',
  'Alice Silva',
  'tutorial',
  '2025-08-01T10:00:00Z',
  [0.45, 0.78, 0.12, 0.93, 0.34, 0.67, 0.55, 0.21]
);

INSERT INTO articles (title, body, author, category, published_at, _vector)
VALUES (
  'Vector Search Deep Dive',
  'Understanding how vector similarity search works under the hood. We explore HNSW indexes, cosine distance metrics, and approximate nearest neighbor algorithms used in FunDB.',
  'Bob Santos',
  'technical',
  '2025-08-15T14:00:00Z',
  [0.82, 0.19, 0.64, 0.37, 0.91, 0.28, 0.73, 0.46]
);

INSERT INTO articles (title, body, author, category, published_at, _vector)
VALUES (
  'Graph Databases vs FunDB',
  'Comparing traditional graph databases with FunDB integrated graph traversal. Unlike Neo4j or ArangoDB, FunDB embeds graph edges directly into the record model.',
  'Carol Souza',
  'comparison',
  '2025-09-01T09:00:00Z',
  [0.56, 0.41, 0.88, 0.23, 0.69, 0.52, 0.17, 0.84]
);

INSERT INTO articles (title, body, author, category, published_at, _vector)
VALUES (
  'Building AI Agents with FunDB',
  'How to use FunDB as the memory layer for autonomous AI agents. REMEMBER, RECALL, and FORGET commands give agents persistent, searchable memory with confidence tracking.',
  'Dave Oliveira',
  'tutorial',
  '2025-09-15T11:00:00Z',
  [0.31, 0.85, 0.47, 0.72, 0.19, 0.93, 0.38, 0.61]
);

INSERT INTO articles (title, body, author, category, published_at, _vector)
VALUES (
  'Causal Reasoning in Databases',
  'An introduction to causal inference inside FunDB. From explicit causal edges to Granger causality and structural causal models, FunDB supports three tiers of causal reasoning.',
  'Eva Lima',
  'technical',
  '2025-10-01T10:00:00Z',
  [0.68, 0.22, 0.79, 0.55, 0.43, 0.86, 0.31, 0.74]
);

INSERT INTO articles (title, body, author, category, published_at, _vector)
VALUES (
  'FunDB Performance Benchmarks',
  'We benchmark FunDB against PostgreSQL, MongoDB, and Pinecone across different workloads: OLTP writes, vector search, and graph traversal queries.',
  'Frank Pereira',
  'benchmark',
  '2025-10-15T15:00:00Z',
  [0.77, 0.33, 0.51, 0.89, 0.16, 0.62, 0.44, 0.95]
);

INSERT INTO articles (title, body, author, category, published_at, _vector)
VALUES (
  'Confidence Scores Explained',
  'How FunDB propagates confidence scores through query operations. JOIN uses minimum, UNION uses maximum, and aggregation uses weighted average.',
  'Grace Almeida',
  'tutorial',
  '2025-11-01T09:30:00Z',
  [0.42, 0.91, 0.35, 0.68, 0.57, 0.24, 0.83, 0.49]
);

INSERT INTO articles (title, body, author, category, published_at, _vector)
VALUES (
  'Migrating from PostgreSQL to FunDB',
  'A practical guide to migrating your PostgreSQL application to FunDB. FunDB speaks the PostgreSQL wire protocol, so most clients work out of the box.',
  'Henry Costa',
  'guide',
  '2025-11-15T12:00:00Z',
  [0.59, 0.27, 0.94, 0.41, 0.83, 0.18, 0.66, 0.52]
);

