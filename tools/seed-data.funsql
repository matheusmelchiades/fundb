  'Machine Learning Fundamentals',
  'Machine learning is a subset of artificial intelligence that enables systems to learn from data. Supervised learning uses labeled datasets, while unsupervised learning discovers hidden patterns.',
  'MIT OpenCourseWare',
  'education',
  0.96,
  [0.91, 0.45, 0.23, 0.78, 0.56, 0.34, 0.67, 0.12]
);

INSERT INTO documents (title, content, source, doc_type, _confidence, _vector)
VALUES (
