  'Stanford CS231n',
  'education',
  0.93,
  [0.87, 0.41, 0.29, 0.73, 0.62, 0.38, 0.55, 0.19]
);

INSERT INTO documents (title, content, source, doc_type, _confidence, _vector)
VALUES (
  'Database Indexing Strategies',
  'B-tree indexes provide O(log n) lookup for equality and range queries. Hash indexes offer O(1) equality lookups. LSM-trees optimize for write-heavy workloads.',
  'Database Internals by Alex Petrov',
  'reference',
  0.91,
  [0.34, 0.72, 0.88, 0.15, 0.49, 0.63, 0.27, 0.81]
);

INSERT INTO documents (title, content, source, doc_type, _confidence, _vector)
VALUES (
  'Distributed Consensus Algorithms',
  'Raft is a consensus algorithm designed for understandability. It ensures that all nodes in a distributed system agree on the same log of commands through leader election and log replication.',
  'In Search of an Understandable Consensus Algorithm',
  'paper',
  0.89,
  [0.52, 0.18, 0.76, 0.93, 0.41, 0.67, 0.33, 0.85]
);

INSERT INTO documents (title, content, source, doc_type, _confidence, _vector)
VALUES (
  'Vector Similarity Metrics',
  'Cosine similarity measures the angle between two vectors. Euclidean distance measures absolute distance. Dot product similarity combines magnitude and direction.',
  'Information Retrieval Textbook',
  'reference',
  0.94,
  [0.78, 0.25, 0.61, 0.42, 0.89, 0.33, 0.71, 0.47]
);

INSERT INTO documents (title, content, source, doc_type, _confidence, _vector)
VALUES (
  'Causal Inference Methods',
  'Pearl causal model uses directed acyclic graphs to represent cause-effect relationships. Interventional queries ask what happens if we change a variable. Counterfactuals ask what would have happened.',
  'The Book of Why by Judea Pearl',
  'reference',
  0.92,
  [0.63, 0.39, 0.84, 0.21, 0.57, 0.78, 0.45, 0.91]
);

INSERT INTO documents (title, content, source, doc_type, _confidence, _vector)
VALUES (
  'Time-Series Data Management',
  'Time-series databases optimize for sequential writes and range queries over time. Bitemporal models track both the valid time and the system time of each record.',
  'Timescale Documentation',
  'reference',
  0.87,
  [0.41, 0.83, 0.52, 0.19, 0.74, 0.36, 0.68, 0.95]
);

INSERT INTO documents (title, content, source, doc_type, _confidence, _vector)
VALUES (
  'Graph Traversal Algorithms',
  'Breadth-first search explores all neighbors before going deeper. Depth-first search explores as far as possible before backtracking. Both have O(V+E) complexity.',
  'Introduction to Algorithms by CLRS',
  'education',
  0.95,
  [0.29, 0.67, 0.43, 0.81, 0.55, 0.92, 0.18, 0.73]
);

INSERT INTO documents (title, content, source, doc_type, _confidence, _vector)
VALUES (
